{
  "openapi": "3.1.0",
  "info": {
    "title": "Autumn Print Bootstrap",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List Tasks",
        "operationId": "list_tasks",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  },
                  "type": "array",
                  "title": "Response List Tasks"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/tasks/diagnostic": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_diagnostic",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/tasks/{task_id}": {
      "get": {
        "summary": "Get",
        "operationId": "get_task",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{task_id}/events": {
      "get": {
        "summary": "Task Events",
        "operationId": "task_events",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskEvent"
                  },
                  "title": "Response Task Events"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/edge/register": {
      "post": {
        "summary": "Register",
        "operationId": "register_edge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EdgeRegistration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/edge/{edge_id}/claim": {
      "post": {
        "summary": "Claim",
        "operationId": "claim_command",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "edge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Edge Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Command"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Claim Command"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/edge/{edge_id}/commands/{command_id}/complete": {
      "post": {
        "summary": "Complete",
        "operationId": "complete_command",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "edge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Edge Id"
            }
          },
          {
            "name": "command_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Command Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Command": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "lease_token": {
            "type": "string",
            "title": "Lease Token"
          },
          "protocol_version": {
            "type": "string",
            "const": "1",
            "title": "Protocol Version",
            "default": "1"
          },
          "tool": {
            "type": "string",
            "const": "fake-diagnostic",
            "title": "Tool",
            "default": "fake-diagnostic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "task_id",
          "lease_token"
        ],
        "title": "Command"
      },
      "CompleteCommand": {
        "properties": {
          "lease_token": {
            "type": "string",
            "title": "Lease Token"
          },
          "receipt": {
            "$ref": "#/components/schemas/Receipt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lease_token",
          "receipt"
        ],
        "title": "CompleteCommand"
      },
      "DiagnosticRequest": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\w-]+$",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotency_key"
        ],
        "title": "DiagnosticRequest"
      },
      "EdgeRegistration": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1",
            "title": "Protocol Version",
            "default": "1"
          },
          "edge_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[\\w-]+$",
            "title": "Edge Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "edge_id"
        ],
        "title": "EdgeRegistration"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Receipt": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "1",
            "title": "Protocol Version",
            "default": "1"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "tool": {
            "type": "string",
            "const": "fake-diagnostic",
            "title": "Tool",
            "default": "fake-diagnostic"
          },
          "message": {
            "type": "string",
            "maxLength": 256,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Receipt"
      },
      "Task": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workspace": {
            "type": "string",
            "title": "Workspace"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "waiting_edge",
              "succeeded"
            ],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Receipt"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "workspace",
          "status"
        ],
        "title": "Task"
      },
      "TaskEvent": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "task_id",
          "kind"
        ],
        "title": "TaskEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
