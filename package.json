{
  "name": "autumn-print",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "python scripts/dev.py start",
    "dev:stop": "python scripts/dev.py stop",
    "dev:desktop": "pnpm --filter @autumn/desktop dev",
    "build": "pnpm --filter @autumn/desktop build",
    "generate": "python scripts/generate_contracts.py && openapi-typescript packages/sdk-ts/openapi.json -o packages/sdk-ts/src/schema.d.ts",
    "typecheck": "pnpm --filter @autumn/desktop typecheck",
    "check": "python scripts/check_boundaries.py && pnpm typecheck",
    "test:desktop": "node tests/desktop-smoke.mjs"
  },
  "devDependencies": {"openapi-typescript": "^7.10.1", "@playwright/test": "^1.56.1"}
}
